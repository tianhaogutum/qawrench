{
  "version": 1,
  "required_region": "main",
  "sibling_identity": [{"selector": "article", "key_attribute": "id"}],
  "ignore_selectors": [
    ".noise",
    ".noise",
    {"selector": ".old-noise", "min_matches": 0},
    {"selector": ".new-noise", "min_matches": 0},
    ".inner"
  ],
  "volatile_attributes": [
    {"selector": "article", "attributes": ["data-render"]},
    {"selector": "article", "attributes": ["data-render"]},
    {"selector": "[data-render^=old]", "attributes": ["data-render"], "min_matches": 0},
    {"selector": "[data-render^=new]", "attributes": ["data-render"], "min_matches": 0}
  ]
}
