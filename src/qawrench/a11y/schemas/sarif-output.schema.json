{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bridge SARIF output contract (a constrained subset, not the official SARIF schema)",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://json.schemastore.org/sarif-2.1.0.json"},
    "version": {"const": "2.1.0"},
    "runs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
      "type": "object", "required": ["tool", "results", "invocations", "properties"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "object", "required": ["driver"], "properties": {
          "driver": {"type": "object", "required": ["name", "version", "rules"], "properties": {
            "name": {"const": "a11y-baseline-bridge"}, "version": {"type": "string"},
            "rules": {"type": "array", "items": {"type": "object", "required": ["id", "shortDescription", "helpUri", "properties"], "properties": {
              "id": {"type": "string", "pattern": "^(axe|pa11y-ci/(htmlcs|axe)):"},
              "shortDescription": {"$ref": "#/definitions/message"}, "helpUri": {"type": "string", "format": "uri"},
              "properties": {"type": "object", "required": ["engine", "nativeRuleId"]}
            }}}
          }}
        }},
        "invocations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["executionSuccessful"], "properties": {"executionSuccessful": {"const": true}}}},
        "properties": {"type": "object", "required": ["counts", "gate", "identityPolicy"]},
        "results": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["ruleId", "ruleIndex", "level", "message", "baselineState", "partialFingerprints", "locations", "properties"],
          "properties": {
            "ruleId": {"type": "string"}, "ruleIndex": {"type": "integer", "minimum": 0},
            "level": {"enum": ["note", "warning", "error"]}, "message": {"$ref": "#/definitions/message"},
            "baselineState": {"enum": ["new", "unchanged", "absent"]},
            "partialFingerprints": {"type": "object", "required": ["a11yBaselineIdentity/v1"], "properties": {"a11yBaselineIdentity/v1": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
            "locations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["physicalLocation"], "properties": {
              "physicalLocation": {"type": "object", "additionalProperties": false, "required": ["artifactLocation"], "properties": {
                "artifactLocation": {"type": "object", "additionalProperties": false, "required": ["uri"], "properties": {"uri": {"type": "string", "format": "uri"}}}
              }}
            }}},
            "properties": {"type": "object", "required": ["engine", "nativeRuleId", "pageUrl", "selector", "impact", "severity", "occurrence", "native"], "properties": {
              "engine": {"enum": ["axe", "pa11y-ci/htmlcs", "pa11y-ci/axe"]},
              "pageUrl": {"type": "string", "pattern": "^https?://[^/]+/", "description": "Retained native HTTP(S) identity text, which may contain Unicode or quotes. This is not the URI-encoded artifact location; native validation is performed by the bridge."},
              "selector": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 2, "items": {"type": "string"}}]}}]},
              "impact": {"enum": [null, "minor", "moderate", "serious", "critical"]},
              "severity": {"enum": [null, "minor", "moderate", "serious", "critical"]},
              "occurrence": {"type": "integer", "minimum": 1}, "native": {"type": "object"}
            }}
          }
        }}
      }
    }}
  },
  "definitions": {"message": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}}}
}
